#property strict

input string PlatformUrl = "http://127.0.0.1:8000"; // Control API base (example)
input int    HeartbeatSec = 3;

datetime lastHeartbeat = 0;

int OnInit()
{
   Print("Cacsms-Bullion Bridge initialized.");
   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason)
{
   Print("Cacsms-Bullion Bridge stopped.");
}

void OnTick()
{
   // Heartbeat: you can push terminal state to your connector service.
   if(TimeCurrent() - lastHeartbeat >= HeartbeatSec)
   {
      lastHeartbeat = TimeCurrent();
