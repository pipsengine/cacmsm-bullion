# Copy to .env and replace every placeholder before running Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_API_TOKEN=replace-with-a-long-random-token
WEB_AUTH_USER=admin
WEB_AUTH_PASSWORD=replace-with-a-long-random-password

# SQL Server is external to docker-compose.yml.
MSSQL_SERVER=host.docker.internal
MSSQL_ADMIN_USER=sa
MSSQL_ADMIN_PASSWORD=replace-with-the-sql-admin-password
MSSQL_APP_USER=cacsms
MSSQL_APP_PASSWORD=replace-with-a-distinct-long-random-password

# Exactly 32 random bytes, encoded as base64 (or 64 hexadecimal characters).
MT5_CREDENTIAL_KEY=replace-with-a-32-byte-base64-key
